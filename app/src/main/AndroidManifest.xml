<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Status refresh (WebView scrape / optional APIs) and Google sync; the app is
         fully usable offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".ClearTravelApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClearTravel">

        <!-- Maps SDK key: read from local.properties via manifestPlaceholders; an empty
             value is safe (the map view renders blank tiles until a key is supplied). -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- singleTask: warm notification/deep-link launches reuse the single shell
             instance via onNewIntent instead of stacking duplicates. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ClearTravel.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share-sheet entry: shared IRCTC SMS/email text prefills the train
                 ticket form directly; shared images/PDFs open the "What's this file?"
                 intake (train ticket / boarding pass / booking confirmation). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <!-- PNR share links (ADR-020): the https link we put in shared captions.
                 Deliberately NOT autoVerify — no owned domain with assetlinks yet, so
                 the system chooser (browser vs. app) is the expected behaviour. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="itsluminous.github.io"
                    android:pathPrefix="/ClearTravel/pnr/"
                    android:scheme="https" />
            </intent-filter>
            <!-- Custom-scheme twin: cleartravel://pnr/<pnr>. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="pnr"
                    android:scheme="cleartravel" />
            </intent-filter>
        </activity>

        <!-- Exposes rendered share images (cacheDir/share/) and stored documents /
             boarding passes / attachments (filesDir/…) to chooser targets; roots in
             res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
