{
  "id": "erail-route",
  "displayName": "eRail.in Train Route",
  "version": 2,
  "kind": "train",
  "urlTemplate": "https://erail.in/train-enquiry/{trainNumber}",
  "prefill": [],
  "submitSelector": null,
  "readySignal": {
    "jsCondition": "document.querySelectorAll('#divResult table.DataTable tr').length > 1"
  },
  "extract": {
    "trainNumber": { "selector": "title", "regexChain": ["^([0-9]+)"], "required": true },
    "trainName": { "selector": "title", "regexChain": ["^[0-9]+\\s+(.+?)\\s+Train Route$"] }
  },
  "rows": {
    "rowSelector": "#divResult table.DataTable tr:not(:first-child)",
    "minRows": 2,
    "fields": {
      "stationName": { "selector": "td:nth-child(2)" },
      "arrival": { "selector": "td:nth-child(3)" },
      "departure": { "selector": "td:nth-child(4)" },
      "distance": { "selector": "td:nth-child(5)" },
      "platform": { "selector": "td:nth-child(6)" }
    }
  }
}
