{
  "id": "ixigo-route",
  "displayName": "ixigo Train Route",
  "version": 4,
  "kind": "train",
  "urlTemplate": "https://www.ixigo.com/trains/{trainNumber}",
  "dismissSelectors": [".download-banner-close-btn", ".app-download-popup .close-btn", ".close-banner"],
  "prefill": [],
  "submitSelector": null,
  "readySignal": {
    "jsCondition": "document.querySelectorAll('table.train-route-cntr tbody tr').length > 1"
  },
  "extract": {
    "trainNumber": { "selector": "h1", "regexChain": ["([0-9]+)\\s+Train$"], "required": true },
    "trainName": { "selector": "h1", "regexChain": ["^(.+?)\\s+[0-9]+\\s+Train$"] }
  },
  "rows": {
    "rowSelector": "table.train-route-cntr tbody tr",
    "minRows": 2,
    "fields": {
      "stationCode": {
        "selector": "a.station-name-url",
        "attribute": "href",
        "regexChain": ["([a-z0-9]+)-railway-station"]
      },
      "stationName": { "selector": "a.station-name-url" },
      "arrival": { "selector": ".arrive-time" },
      "departure": { "selector": "td:nth-child(3)" },
      "halt": { "selector": "td:nth-child(4)" },
      "distance": { "selector": ".station-cell .sub-text" },
      "platform": { "selector": ".platform" }
    }
  },
  "extraRows": {
    "coaches": {
      "rowSelector": ".coach-position-cntr .coach-box-container, .coach-position-cntr .coach-box-cntr",
      "minRows": 0,
      "fields": {
        "code": { "selector": ".coach-number, .coach-box" }
      }
    }
  }
}
