{
  "id": "airindia",
  "displayName": "Air India Flight Status",
  "version": 2,
  "kind": "flight",
  "iataCodes": ["AI"],
  "verified": true,
  "notes": "Selectors from a REAL result capture (docs/recon/airindia.html, 2026-09-20). The page reads ?fno=&on= query params directly (on = yyyyMMdd — feature code formats {date} accordingly), so no prefill/submit is needed; submitSelector stays null. v2: dismissSelectors auto-clicks the OneTrust consent banner (#onetrust-accept-btn-handler) — its .onetrust-pc-dark-filter intercepts POINTER events until dismissed (recon NOTES.md), stalling the hands-free flow. One query can return MULTIPLE .flight-status-card rows (one per leg); the feature-side mapper disambiguates against the saved journey. Date window is today +/- 2 days only.",
  "urlTemplate": "https://www.airindia.com/in/en/manage/flight-status.html?fno={flightNumber}&on={date}",
  "dismissSelectors": ["#onetrust-accept-btn-handler"],
  "prefill": [],
  "submitSelector": null,
  "readySignal": { "selector": ".flight-status-card" },
  "rows": {
    "rowSelector": ".flight-status-card",
    "minRows": 1,
    "fields": {
      "flightLabel": { "selector": ".flight-details-ar .list-inline-item" },
      "status": { "selector": ".ontime-check-state" },
      "aircraftType": { "selector": ".airCraftTypeName" },
      "depAirport": { "selector": ".departure .aiport-name span" },
      "depDate": { "selector": ".departure .sch-dep-date-status-time" },
      "depTimeSched": { "selector": ".departure .fsm-scheduled-time" },
      "depTimeEst": { "selector": ".departure .fsm-estimated-time" },
      "depTerminalGate": { "selector": ".departure .terminal" },
      "arrAirport": { "selector": ".arrival .aiport-name span" },
      "arrDate": { "selector": ".arrival .sch-dep-date-status-time" },
      "arrTimeSched": { "selector": ".arrival .fsm-scheduled-time" },
      "arrTimeEst": { "selector": ".arrival .fsm-estimated-time" },
      "arrTerminalGate": { "selector": ".arrival .terminal" },
      "duration": { "selector": ".duration" },
      "lastUpdated": { "selector": ".last-updated span" }
    }
  }
}
